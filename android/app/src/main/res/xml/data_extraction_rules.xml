<?xml version="1.0" encoding="utf-8"?>
<!--
  TD-152: SettingsDataStore stores accessClientSecret (a Cloudflare Access
  service-token secret) as a plain stringPreferencesKey alongside ordinary,
  non-sensitive settings (host/port/poll interval) in one Preferences
  DataStore file. android:allowBackup="true" (below, in AndroidManifest.xml)
  means Android's Auto Backup would otherwise include that file verbatim —
  cloud backup or `adb backup` on a lost/stolen/reset device would carry the
  secret out with it. Excludes just that one file (confirmed via direct
  bytecode inspection of the pinned androidx.datastore library: preferencesDataStore(name="settings")
  resolves to files/datastore/settings.preferences_pb) from both cloud
  backup and device-to-device transfer, rather than disabling backup for
  the whole app over one file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
