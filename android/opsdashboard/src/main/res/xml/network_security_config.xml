<?xml version="1.0" encoding="utf-8"?>
<!--
  metrics_api_server, mns_server, and registry_server are plain HTTP only (no TLS)
  and reachable at user-configured LAN/VPN addresses entered at runtime in
  Settings, so a scoped per-domain allowlist isn't possible. This app is
  intended for use only against trusted local servers.

  cleartextTrafficPermitted only additionally permits HTTP — it does not
  restrict HTTPS. The Settings "secure relay" mode (HTTPS to a kerfbit.dev
  subdomain) already validates against the system trust-anchors declared
  below, so no config change is needed to support it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
