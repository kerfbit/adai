<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Face Format (WFF) bundle — resource-only, hasCode="false" is required by the
     platform for any app using this manifest <property>. Delivered to the watch via the
     opsdashboard phone app's Watch Face Push integration (WatchFacePushManager), not via
     the normal picker/store install flow — see android/opsdashboard's WatchFacePushRepository
     and docs/development/WEARFACE_WFF.md for why (Samsung's One UI Watch picker only
     surfaces its own curated/Store-synced catalog; Watch Face Push is the OS-mandated
     local/marketplace-style install path that bypasses it, available on Wear OS 6+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/watch_face_name">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="4" />

    </application>

</manifest>
