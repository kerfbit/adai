# ADAI Chatbot Service Configuration File
# This file demonstrates the configuration options for the ADAI chatbot service.
# 
# Configuration priority (highest to lowest):
#   1. Command-line arguments
#   2. Environment variables
#   3. This configuration file
#   4. Default values
#
# To use this file:
#   - Copy to /etc/adai/config.conf (default location)
#   - Or specify with --config /path/to/config.conf
#
# Lines starting with # are comments and are ignored.
# Format: KEY=value (no spaces around =)

# ============================================================================
# Server Configuration
# ============================================================================

# Path to the trained model file (leave empty for random initialization)
# MODEL_PATH=/app/models/model.bin

# Path to the vocabulary file (REQUIRED)
VOCAB_PATH=/app/vocab/vocab.txt

# Port number for the API server
PORT=8080

# Session timeout in minutes
SESSION_TIMEOUT=30

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================================================
# Model Architecture Parameters
# ============================================================================
# These should match the architecture used during training

# Model dimension
D_MODEL=512

# Number of attention heads
NUM_HEADS=8

# Feed-forward network dimension
D_FF=2048

# Number of encoder layers
NUM_ENCODER_LAYERS=6

# Number of decoder layers
NUM_DECODER_LAYERS=6

# Maximum sequence length
MAX_SEQ_LENGTH=1024

# ============================================================================
# Training Hyperparameters
# Used by incremental_trainer; ignored by the inference server
# ============================================================================

# Initial learning rate
LEARNING_RATE=0.0001

# Number of training epochs per session
NUM_EPOCHS=10

# L2 weight decay regularization
WEIGHT_DECAY=0.01

# Gradient clipping norm (0 = disabled)
GRADIENT_CLIP=1.0

# Samples per gradient update
BATCH_SIZE=1

# ============================================================================
# Text Generation Parameters
# ============================================================================

# Maximum length of generated text
MAX_GEN_LENGTH=100

# Temperature for sampling (higher = more random, lower = more deterministic)
# Range: 0.1 to 2.0, Default: 1.0
TEMPERATURE=1.0

# Top-p (nucleus) sampling threshold
# Range: 0.0 to 1.0, Default: 0.9
TOP_P=0.9

# Top-k sampling parameter
TOP_K=50

# Beam width for beam search
BEAM_WIDTH=4

# Generation strategy: greedy, beam, temperature, top_k, nucleus
STRATEGY=nucleus

# ============================================================================
# Training Metrics Service Configuration
# Real-time training metrics collection and monitoring
# ============================================================================

# Enable training metrics service
# Set to true to collect and track training metrics
ENABLE_METRICS_SERVICE=true

# Push metrics to external metrics API daemon
# The daemon (metrics-api-server) should be running as a systemd service
# Start daemon: sudo systemctl start metrics-api-server
# View status: curl http://localhost:8081/api/session/status
METRICS_PUSH_ENABLED=false

# URL of the metrics API daemon
# Default: http://localhost:8081
METRICS_SERVER_URL=http://localhost:8081

# HTTP request timeout for pushing metrics (milliseconds)
# Default: 1000 (1 second)
METRICS_PUSH_TIMEOUT_MS=1000

# Enable persistence of metrics to disk
# When enabled, metrics are saved to JSONL format
METRICS_ENABLE_PERSISTENCE=true

# Path to metrics JSON Lines file
# Each line contains a complete metrics record
METRICS_FILE=training_sessions/metrics.jsonl

# Path to metrics summary JSON file
# Contains aggregated session statistics
METRICS_SUMMARY_FILE=training_sessions/metrics_summary.json

# Persist metrics every N samples (reduces I/O overhead)
# Lower values = more frequent writes, higher values = less I/O
METRICS_PERSIST_EVERY_SAMPLES=100

# Persist metrics every N seconds (ensures periodic updates)
# Guarantees metrics are saved even during slow training
METRICS_PERSIST_EVERY_SECONDS=30

# Maximum records to keep in memory before trimming
# Older records are moved to disk
METRICS_MAX_RECORDS_IN_MEMORY=10000

# Maximum records to keep on disk before rotation
# Oldest records are removed when limit is reached
METRICS_MAX_RECORDS_ON_DISK=100000

# Enable Prometheus format export
# Generates metrics.prom file for Prometheus scraping
METRICS_ENABLE_PROMETHEUS=false

# Path to Prometheus metrics file
METRICS_PROMETHEUS_FILE=training_sessions/metrics.prom

# ============================================================================
# Metrics API Daemon Configuration
# Used when running metrics-api-server as a standalone daemon
# ============================================================================

# Port for metrics API server daemon
# Access endpoints:
#   GET  http://localhost:8081/api/session/status
#   GET  http://localhost:8081/api/metrics/current
#   GET  http://localhost:8081/api/session/epochs
METRICS_API_PORT=8081

# Allow control endpoints (flush, clear)
# Set to false for read-only access in production
# Control endpoints:
#   POST http://localhost:8081/api/control/flush
#   POST http://localhost:8081/api/control/clear
METRICS_API_ALLOW_CONTROL=true
