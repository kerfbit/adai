# cloudflared ingress config for the storage host (192.168.1.16).
# Fronts metrics_api_server, mns_server, and registry_server's HTTP API
# under kerfbit.dev subdomains. See docs/operations/deployment/CLOUDFLARE_TUNNEL_RELAY.md.
#
# Fill in the placeholders below with real values from `cloudflared tunnel create
# adai-storage-tunnel`, then install with:
#   sudo ./scripts/cloudflared/install_cloudflared.sh \
#     --tunnel-name adai-storage-tunnel --config-src <this-file> --yes
#
# NEVER commit a filled-in copy of this file (it embeds the tunnel UUID and, by
# reference, the path to the credentials JSON, which is private key material).

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: metrics.kerfbit.dev
    service: http://localhost:8081
  - hostname: mns.kerfbit.dev
    service: http://localhost:8083
  - hostname: registry.kerfbit.dev
    service: http://localhost:8082
  - service: http_status:404
